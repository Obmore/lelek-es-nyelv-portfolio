{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lelek-urlap",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "urlap.lelekesnyelv.hu", "custom_domain": true }],
  "send_email": [{ "name": "EMAIL", "destination_address": "juhasznagyanna@gmail.com" }],
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "4101", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_GLOBAL", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
